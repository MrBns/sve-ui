{
  "name": "sve-ui",
  "version": "0.0.1",
  "private": true,
  "description": "Headless, functional Svelte 5 UI component library",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "dev": "bun run --filter './apps/docs' dev",
    "lint": "bun run --filter '*' lint",
    "typecheck": "bun run --filter '*' typecheck",
    "clean": "find . -name 'dist' -type d -not -path '*/node_modules/*' | xargs rm -rf"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
