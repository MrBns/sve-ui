{
  "name": "@sve-ui/auto-complete",
  "version": "0.0.1",
  "description": "Headless Svelte 5 auto-complete/combobox component",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "svelte-package -i src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "svelte": "^5.0.0",
    "typescript": "^5.5.0",
    "svelte-check": "^4.0.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@sve-ui/shared": "workspace:*"
  }
}
